# Telegram，来自 https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# 由 scripts/login.py 生成；等同账号登录态，泄露即账号被接管，切勿提交
TG_SESSION_STRING=

# 可选：有新文件时用 Bot 推送通知
BOT_TOKEN=
BOT_CHAT_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# 可选：state 与文件分桶（不填则都用 R2_BUCKET）
R2_STATE_BUCKET=
R2_STATE_KEY=state/state.json
R2_KEY_PREFIX=files
